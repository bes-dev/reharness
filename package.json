{
  "name": "reharness",
  "version": "0.2.0",
  "description": "A reasoning compiler — turn a natural-language request or a recorded agent trace into a deterministic FSM pipeline, with model judgment only at the leaves.",
  "keywords": [
    "reasoning-compiler",
    "llm",
    "ai-agents",
    "agent",
    "fsm",
    "state-machine",
    "workflow",
    "compiler",
    "pipeline",
    "programming-by-demonstration"
  ],
  "author": "bes-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bes-dev/reharness.git"
  },
  "homepage": "https://github.com/bes-dev/reharness#readme",
  "bugs": "https://github.com/bes-dev/reharness/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    }
  },
  "bin": {
    "reharness": "dist/cli.js"
  },
  "scripts": {
    "build": "node node_modules/typescript/lib/tsc.js && mkdir -p dist/compiler/agents && rm -f dist/compiler/agents/*.md && cp src/compiler/agents/*.md dist/compiler/agents/ && chmod +x dist/cli.js",
    "test": "node --import tsx --test $(find tests -name '*.test.ts')",
    "e2e": "npm run build && node --import tsx tests/e2e/evolve.mts",
    "dev": "node node_modules/typescript/lib/tsc.js --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/node": "^20.0.0",
    "fast-xml-parser": "^5.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
